+
+    /// Clicks every beat, the first of each bar louder, as a four on the
+    /// floor with an accented kick sounds.
+    fn bars(bpm: f64, seconds: f64) -> Vec<f64> {
+        let rate = SAMPLE_RATE as f64;
+        let mut samples = vec![0.0; (seconds * rate) as usize * CHANNELS];
+        let period = rate * 60.0 / bpm;
+        let mut click = 0.0;
+        let mut number = 0;
+        while click < seconds * rate {
+            let strength = if number % 4 == 0 { 0.9 } else { 0.3 };
+            for offset in 0..(rate * 0.05) as usize {
+                let at = click as usize + offset;
+                if at >= samples.len() / CHANNELS {
+                    break;
+                }
+                let envelope = (-(offset as f64) / (rate * 0.012)).exp();
+                let value = (offset as f64 / rate * 80.0 * std::f64::consts::TAU).sin()
+                    * envelope
+                    * strength;
+                samples[at * CHANNELS] = value;
+                samples[at * CHANNELS + 1] = value;
+            }
+            click += period;
+            number += 1;
+        }
+        samples
+    }
+
+    #[test]
+    fn the_tracker_finds_the_bar_line_the_kick_accents() {
+        let mut tracker = BeatTracker::new(0);
+        tracker.feed(&bars(120.0, 8.0), 0);
+        let grid = tracker.estimate().expect("a beat");
+        assert!((grid.period_ms - 500.0).abs() < 6.0);
+        assert!((grid.bar_ms() - 2000.0).abs() < 24.0);
+        // The bar line lands on one of the accented kicks.
+        let line = grid.bar_at_or_before(4_500.0);
+        let beat = ((line - grid.phase_ms) / grid.period_ms).round() as i64;
+        assert_eq!(beat.rem_euclid(4) as u8, grid.bar_phase);
+        let nearest = (line / 2_000.0).round() * 2_000.0;
+        assert!(
+            (line - nearest).abs() < 60.0,
+            "bar line at {line} ms, accents at 0, 2000, 4000"
+        );
+    }
+
+    #[test]
+    fn bar_lines_land_on_the_bar_and_the_nearest_one_wins() {
+        let grid = BeatGrid {
+            period_ms: 500.0,
+            phase_ms: 20.0,
+            bar_phase: 1,
+            confidence: 0.5,
+        };
+        // Beats at 20, 520, 1020, 1520; the bar starts on the second of each
+        // four, so at 520, 2520, 4520.
+        assert!((grid.bar_at_or_before(2_600.0) - 2_520.0).abs() < 1e-9);
+        assert!((grid.bar_at_or_before(2_400.0) - 520.0).abs() < 1e-9);
+        assert!((grid.nearest_bar(2_100.0) - 2_520.0).abs() < 1e-9);
+        assert!((grid.nearest_bar(2_300.0) - 2_520.0).abs() < 1e-9);
+        assert!((grid.nearest_bar(5_000.0) - 4_520.0).abs() < 1e-9);
+        assert!((grid.bar_ms() - 2_000.0).abs() < 1e-9);
+    }
+
+    #[test]
+    fn the_incoming_opening_enters_on_a_bar_line() {
+        let samples = bars(120.0, 6.0);
+        let entry = opening_entry(&samples, samples.len() / CHANNELS);
+        let grid = entry.grid.expect("a beat");
+        let at_ms = entry.at as f64 * MS_PER_FRAME;
+        let beat = ((at_ms - grid.phase_ms) / grid.period_ms).round() as i64;
+        assert_eq!(beat.rem_euclid(4) as u8, grid.bar_phase);
+    }
+
+    #[test]
+    fn the_bass_swap_holds_the_low_end_back_and_keeps_the_rest() {
+        let frames = SAMPLE_RATE as usize;
+        let tone = |hertz: f64| -> Vec<f64> {
+            let mut samples = Vec::with_capacity(frames * CHANNELS);
+            for frame in 0..frames {
+                let value =
+                    (frame as f64 / SAMPLE_RATE as f64 * hertz * std::f64::consts::TAU).sin();
+                samples.push(value);
+                samples.push(value);
+            }
+            samples
+        };
+        let rms = |samples: &[f64], from: usize, to: usize| -> f64 {
+            let mut sum = 0.0;
+            let mut count = 0;
+            for frame in from..to {
+                sum += samples[frame * CHANNELS] * samples[frame * CHANNELS];
+                count += 1;
+            }
+            (sum / count as f64).sqrt()
+        };
+
+        // The kick band is held back at the start and whole again by the end.
+        let mut low = tone(60.0);
+        let before = low.clone();
+        bass_swap(&mut low, frames);
+        let start = rms(&low, frames / 10, frames / 3) / rms(&before, frames / 10, frames / 3);
+        let end = rms(&low, frames * 9 / 10, frames) / rms(&before, frames * 9 / 10, frames);
+        assert!(start < 0.25, "low end at the start: {start}");
+        // The cutoff reaches open, so the low end comes back whole.
+        assert!((end - 1.0).abs() < 0.1, "low end at the end: {end}");
+
+        // Everything above the kick passes through untouched.
+        let mut high = tone(5_000.0);
+        let reference = high.clone();
+        bass_swap(&mut high, frames);
+        let ratio = rms(&high, frames / 10, frames / 3) / rms(&reference, frames / 10, frames / 3);
+        assert!((ratio - 1.0).abs() < 0.05, "high end: {ratio}");
+    }
+
+    #[test]
+    fn the_opening_enters_where_the_intro_gives_way_to_the_drop() {
+        let rate = SAMPLE_RATE as f64;
+        let period = rate * 0.5;
+        let seconds = 12.0;
+        let mut samples = vec![0.0; (seconds * rate) as usize * CHANNELS];
+        let mut click = 0.0;
+        let mut number = 0;
+        while click < seconds * rate {
+            let bar = number / 4;
+            // The bar's first beat carries the accent, as a kick on the one.
+            let accent = if number % 4 == 0 { 0.8 } else { 0.35 };
+            let strength = if bar < 2 { accent * 0.06 } else { accent };
+            for offset in 0..(rate * 0.05) as usize {
+                let at = click as usize + offset;
+                if at >= samples.len() / CHANNELS {
+                    break;
+                }
+                let envelope = (-(offset as f64) / (rate * 0.012)).exp();
+                let value = (offset as f64 / rate * 80.0 * std::f64::consts::TAU).sin()
+                    * envelope
+                    * strength;
+                samples[at * CHANNELS] = value;
+                samples[at * CHANNELS + 1] = value;
+            }
+            click += period;
+            number += 1;
+        }
+        let entry = opening_entry(&samples, samples.len() / CHANNELS);
+        let at_ms = entry.at as f64 * MS_PER_FRAME;
+        assert!(
+            (3_800.0..4_300.0).contains(&at_ms),
+            "entered at {at_ms} ms, the drop is at 4000"
+        );
+    }
+
+    #[test]
+    fn the_sweep_thins_the_outgoing_low_end_as_it_leaves() {
+        let frames = SAMPLE_RATE as usize;
+        let tone = |hertz: f64| -> Vec<f64> {
+            let mut samples = Vec::with_capacity(frames * CHANNELS);
+            for frame in 0..frames {
+                let value =
+                    (frame as f64 / SAMPLE_RATE as f64 * hertz * std::f64::consts::TAU).sin();
+                samples.push(value);
+                samples.push(value);
+            }
+            samples
+        };
+        let rms = |samples: &[f64], from: usize, to: usize| -> f64 {
+            let mut sum = 0.0;
+            let mut count = 0;
+            for frame in from..to {
+                sum += samples[frame * CHANNELS] * samples[frame * CHANNELS];
+                count += 1;
+            }
+            (sum / count as f64).sqrt()
+        };
+
+        // At the start the filter is out of the way.
+        let mut early = tone(60.0);
+        let reference = early.clone();
+        Sweep::default().process(&mut early, 0, frames);
+        let ratio = rms(&early, frames / 10, frames / 3) / rms(&reference, frames / 10, frames / 3);
+        assert!((ratio - 1.0).abs() < 0.1, "low end at the start: {ratio}");
+
+        // At the end the low end is gone and the top is still there.
+        let mut late = tone(60.0);
+        let reference = late.clone();
+        Sweep::default().process(&mut late, frames * 9 / 10, frames);
+        let low = rms(&late, frames / 10, frames / 3) / rms(&reference, frames / 10, frames / 3);
+        assert!(low < 0.2, "low end at the end: {low}");
+        let mut high = tone(5_000.0);
+        let reference = high.clone();
+        Sweep::default().process(&mut high, frames * 9 / 10, frames);
+        let high = rms(&high, frames / 10, frames / 3) / rms(&reference, frames / 10, frames / 3);
+        // The one-pole leaves the top nearly whole (a decibel or so down).
+        assert!(high > 0.8, "high end at the end: {high}");
+    }
+
+    #[test]
+    fn frames_and_milliseconds_round_trip() {
+        for ms in [0u32, 1, 13, 500, 6_000, 12_000] {
+            let back = ms_of(frames(ms as f64));
+            assert!(back.abs_diff(ms) <= 1, "{ms} became {back}");
+        }
+    }
+}
