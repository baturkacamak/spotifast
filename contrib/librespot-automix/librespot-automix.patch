+/// A mix between the track that is ending and the track that follows.
+#[derive(Default)]
+struct Crossfade {
+    /// The incoming track the opening belongs to.
+    track: Option<SpotifyUri>,
+    /// Its opening, decoded before the outgoing track ends.
+    opening: Option<Opening>,
+    /// Frames of the opening already played.
+    played: usize,
+    /// Whether the two tracks are being mixed now.
+    active: bool,
+    /// The opening has been heard in full. The outgoing track stays silent
+    /// until it ends, so its sound never comes back at full level after the
+    /// mix has finished.
+    finished: bool,
+    /// The filter that pulls the outgoing song's low end away as it leaves.
+    sweep: crate::crossfade::Sweep,
+    /// Whether the outgoing track's beats were read for this mix.
+    analysed: bool,
+    /// Where they fall, when the track has a beat to place the mix on.
+    grid: Option<crate::crossfade::BeatGrid>,
+}
+
+impl Crossfade {
+    /// Whether any of the opening was heard.
+    fn heard(&self) -> bool {
+        self.played > 0
+    }
+}
+
+/// The incoming track's opening, ready to be mixed over the outgoing track.
+struct Opening {
+    /// Interleaved stereo samples at the playback rate, already pulled to
