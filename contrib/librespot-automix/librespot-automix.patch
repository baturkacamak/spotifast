+//! Beat-aligned, tempo-matched crossfades between one track and the next.
+//!
+//! librespot decodes the opening of the preloaded next track while the
+//! current one plays, so the two can be mixed over the outgoing track's last
+//! bars. This module holds the parts that do not need the player: an onset
+//! tracker that estimates the tempo and where the beats fall, the choice of
+//! where the incoming track should enter, the pull of its opening to the
+//! outgoing tempo, and the equal-power gain curves of the mix itself.
+//!
+//! Spotify's own Automix works out its transition recipes in a service and a
+//! native library of its own. This is a local approximation: the tempo comes
+//! from the audio, the fade is placed on a beat, and the opening is only
+//! pulled when the two tempos are close enough that the pitch change is not
+//! heard.
+
+use std::collections::VecDeque;
+
+use crate::{NUM_CHANNELS, SAMPLE_RATE};
+
+/// Frames per onset hop, about 23 ms at the playback rate.
+const HOP: usize = 1024;
+
+/// Hops of onset strength kept, about a minute: a whole track's onsets say
+/// far more about its tempo than its last few bars do.
+const HISTORY: usize = 2_600;
+
+/// The tempo range the tracker looks in.
+const MIN_BPM: f64 = 70.0;
+const MAX_BPM: f64 = 180.0;
+
+/// The furthest the incoming opening is pulled, as a fraction of its own
+/// tempo. A wider pull changes the key enough to be heard.
+pub const MAX_STRETCH: f64 = 0.04;
+
+/// Beat grids weaker than this are not trusted: the mix then falls back to a
+/// plain crossfade.
+pub const MIN_CONFIDENCE: f32 = 0.12;
+
+/// Beats in a bar. Dance music, and the phrases automix plans around, count
+/// in four.
+const BEATS_PER_BAR: usize = 4;
+
+const CHANNELS: usize = NUM_CHANNELS as usize;
+const MS_PER_FRAME: f64 = 1000.0 / SAMPLE_RATE as f64;
+const MS_PER_HOP: f64 = 1000.0 * HOP as f64 / SAMPLE_RATE as f64;
+
+/// Frames of sound in `length_ms`.
+pub fn frames(length_ms: f64) -> usize {
+    (length_ms * SAMPLE_RATE as f64 / 1000.0).max(0.0) as usize
+}
+
+/// Milliseconds of sound in `frames`.
+pub fn ms_of(frames: usize) -> u32 {
+    (frames as f64 * MS_PER_FRAME).round().max(0.0) as u32
+}
+
+/// Where a track's beats fall, from its own opening.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct BeatGrid {
+    /// Milliseconds between beats.
+    pub period_ms: f64,
+    /// Milliseconds into the track of the first beat at or after zero.
+    pub phase_ms: f64,
+    /// Which of every four beats starts the bar: the one the low end
+    /// accents. Beats are counted from `phase_ms`.
+    pub bar_phase: u8,
+    /// How far the beats stand out of the onset envelope. A steady four on
+    /// the floor scores well above noise.
+    pub confidence: f32,
+}
+
+impl BeatGrid {
+    /// Milliseconds in a bar of this tempo.
+    pub fn bar_ms(&self) -> f64 {
+        self.period_ms * BEATS_PER_BAR as f64
+    }
+
+    /// Where `time_ms` falls in bars, counted from the first bar line.
+    fn bar_position(&self, time_ms: f64) -> f64 {
+        ((time_ms - self.phase_ms) / self.period_ms - f64::from(self.bar_phase))
+            / BEATS_PER_BAR as f64
+    }
+
+    fn bar_line(&self, index: f64) -> f64 {
+        self.phase_ms + (f64::from(self.bar_phase) + index * BEATS_PER_BAR as f64) * self.period_ms
+    }
+
+    /// The last bar line at or before `time_ms`.
+    pub fn bar_at_or_before(&self, time_ms: f64) -> f64 {
+        self.bar_line(self.bar_position(time_ms).floor())
+    }
+
+    /// The bar line nearest to `time_ms`.
+    pub fn nearest_bar(&self, time_ms: f64) -> f64 {
+        self.bar_line(self.bar_position(time_ms).round())
+    }
+
+    /// The first bar line at or after `time_ms`.
+    pub fn bar_at_or_after(&self, time_ms: f64) -> f64 {
+        self.bar_line(self.bar_position(time_ms).ceil())
+    }
+}
+
+/// Follows a track's onsets as it plays and says where its beats are.
+pub struct BeatTracker {
+    /// Onset strength per hop, oldest first.
+    onsets: VecDeque<f32>,
+    /// Energy summed over the hop being filled.
+    energy: f64,
+    /// Frames in the hop being filled.
+    filled: usize,
+    /// One-pole low-pass state per channel, for the band a kick lives in.
+    low: [f32; CHANNELS],
+    /// The previous hop's level, for the positive difference that is an
+    /// onset.
+    previous: f32,
+    /// Hops seen since `origin_ms`, so hop indices stay absolute.
+    hops: u64,
+    /// Track time of hop zero.
+    origin_ms: f64,
+    /// Track time of the next frame fed in.
+    cursor_ms: f64,
+}
+
+impl BeatTracker {
+    /// A tracker for a track that starts at `position_ms`.
+    pub fn new(position_ms: u32) -> Self {
+        Self {
+            onsets: VecDeque::with_capacity(HISTORY),
+            energy: 0.0,
+            filled: 0,
+            low: [0.0; CHANNELS],
+            previous: 0.0,
+            hops: 0,
+            origin_ms: position_ms as f64,
+            cursor_ms: position_ms as f64,
+        }
+    }
+
+    /// Drops what was heard and starts again at `position_ms`, after a seek
+    /// or a jump the decoder made on its own.
+    pub fn restart(&mut self, position_ms: u32) {
+        *self = Self::new(position_ms);
+    }
+
+    /// Feeds interleaved stereo samples that start at `position_ms`. A jump
+    /// in position means the sound no longer follows the beats heard so far
+    /// and the estimate starts over.
+    pub fn feed(&mut self, samples: &[f64], position_ms: u32) {
+        if (position_ms as f64 - self.cursor_ms).abs() > 30.0 {
+            self.restart(position_ms);
+        }
+        let coefficient = 1.0 - (-std::f64::consts::TAU * 150.0 / SAMPLE_RATE as f64).exp();
+        let coefficient = coefficient as f32;
+        for frame in samples.chunks_exact(CHANNELS) {
+            let mut energy = 0.0;
+            for (channel, sample) in frame.iter().enumerate() {
+                let low = &mut self.low[channel];
+                *low += coefficient * (*sample as f32 - *low);
+                energy += (*low as f64) * (*low as f64);
+            }
+            self.energy += energy;
+            self.filled += 1;
+            self.cursor_ms += MS_PER_FRAME;
+            if self.filled == HOP {
+                self.finish_hop();
+            }
+        }
+    }
+
+    fn finish_hop(&mut self) {
+        let level = (self.energy / HOP as f64).sqrt() as f32;
+        let onset = (level - self.previous).max(0.0);
+        self.previous = level;
+        self.energy = 0.0;
+        self.filled = 0;
+        self.onsets.push_back(onset);
+        if self.onsets.len() > HISTORY {
+            self.onsets.pop_front();
+        }
+        self.hops += 1;
+    }
+
+    /// The onsets kept, with the track time they were heard at.
+    fn heard(&self) -> impl Iterator<Item = (f64, f32)> + '_ {
+        let first = self.hops.saturating_sub(self.onsets.len() as u64) as f64;
+        self.onsets
+            .iter()
+            .enumerate()
+            .map(move |(index, strength)| {
+                (
+                    self.origin_ms + (first + index as f64) * MS_PER_HOP,
+                    *strength,
+                )
+            })
+    }
+
+    /// The tempo and the beat positions, when the sound has a steady beat.
+    pub fn estimate(&self) -> Option<BeatGrid> {
+        let length = self.onsets.len();
+        // Three and a half seconds of onsets, so a bar of slow music is seen
+        // at least once.
+        if length < frames_of_hops(3500.0) {
+            return None;
+        }
+        let strengths: Vec<f32> = self.onsets.iter().copied().collect();
+        let mean = strengths.iter().sum::<f32>() / length as f32;
+        if mean <= f32::EPSILON {
+            return None;
+        }
+        let centred: Vec<f32> = strengths.iter().map(|strength| strength - mean).collect();
+        let variance = centred.iter().map(|value| value * value).sum::<f32>() / length as f32;
+        if variance <= f32::EPSILON {
+            return None;
+        }
+
+        let min_lag = (60_000.0 / MAX_BPM / MS_PER_HOP).floor().max(2.0) as usize;
+        let max_lag = (60_000.0 / MIN_BPM / MS_PER_HOP).ceil() as usize;
+        let mut correlations = vec![0.0f32; max_lag + 1];
+        for lag in min_lag..=max_lag {
+            let mut sum = 0.0;
+            for index in lag..length {
+                sum += centred[index] * centred[index - lag];
+            }
+            correlations[lag] = sum / (length - lag) as f32 / variance;
+        }
+
+        let mut best = min_lag;
+        for lag in min_lag..=max_lag {
+            if correlations[lag] > correlations[best] {
+                best = lag;
+            }
+        }
+        // Half-time tracks correlate just as well at twice the period, and
+        // their beats still fall on the shorter one.
+        let half = best / 2;
+        if half >= min_lag && correlations[half] >= correlations[best] * 0.88 {
+            best = half;
+        }
+        let confidence = correlations[best];
+        if confidence < MIN_CONFIDENCE {
+            return None;
+        }
+
+        // A lag is a whole number of hops, which at 98 BPM is 1.4 % away
+        // from the tempo; the peak's neighbours say where it really is.
+        let refined = if best > min_lag && best < max_lag {
+            let (before, peak, after) = (
+                correlations[best - 1] as f64,
+                correlations[best] as f64,
+                correlations[best + 1] as f64,
+            );
+            let curvature = before - 2.0 * peak + after;
+            if curvature < 0.0 {
+                best as f64 + 0.5 * (before - after) / curvature
+            } else {
+                best as f64
+            }
+        } else {
+            best as f64
+        };
+        // The period is measured again against the onsets themselves: the
+        // period whose beats the onsets gather around, and how tightly they
+        // gather. A whole number of hops is 1 % off at the slow end of the
+        // range, which over a few bars is a beat out of place.
+        let heard: Vec<(f64, f64)> = self
+            .heard()
+            .map(|(time, strength)| (time, f64::from(strength)))
+            .collect();
+        let total: f64 = heard.iter().map(|(_, strength)| strength).sum();
+        if total <= 0.0 {
+            return None;
+        }
+        let mut period_ms = refined * MS_PER_HOP;
+        let mut side = 0.0;
+        let mut front = 0.0;
+        let mut closeness = f64::MIN;
+        for step in -30..=30 {
+            let hops = refined + f64::from(step) * 0.05;
+            if !(min_lag as f64..=max_lag as f64).contains(&hops) {
+                continue;
+            }
+            let candidate = hops * MS_PER_HOP;
+            let (mut sine, mut cosine) = (0.0, 0.0);
+            for (time, strength) in &heard {
+                let angle = std::f64::consts::TAU * time / candidate;
+                sine += strength * angle.sin();
+                cosine += strength * angle.cos();
+            }
+            let coherence = (sine * sine + cosine * cosine).sqrt() / total;
+            if coherence > closeness {
+                closeness = coherence;
+                period_ms = candidate;
+                side = sine;
+                front = cosine;
+            }
+        }
+        let phase_ms =
+            (period_ms * side.atan2(front) / std::f64::consts::TAU).rem_euclid(period_ms);
+
+        // The bar's first beat is the one the low end hits hardest. Beats are
+        // numbered from `phase_ms`, so the answer lines up with the bar lines
+        // the mix asks for later.
+        let mut strength_of = [0.0f64; BEATS_PER_BAR];
+        let mut beats_of = [0u32; BEATS_PER_BAR];
+        for (time, strength) in &heard {
+            let beat = ((time - phase_ms) / period_ms).round() as i64;
+            let within = beat.rem_euclid(BEATS_PER_BAR as i64) as usize;
+            strength_of[within] += strength;
+            beats_of[within] += 1;
+        }
+        let bar_phase = (0..BEATS_PER_BAR)
+            .max_by(|left, right| {
+                let mean = |index: usize| strength_of[index] / f64::from(beats_of[index].max(1));
+                mean(*left).total_cmp(&mean(*right))
+            })
+            .unwrap_or(0) as u8;
+
+        Some(BeatGrid {
+            period_ms,
+            phase_ms,
+            bar_phase,
+            confidence,
+        })
+    }
+}
+
+fn frames_of_hops(milliseconds: f64) -> usize {
+    (milliseconds / MS_PER_HOP).ceil() as usize
+}
+
+/// The level of a run of frames, for finding where an opening gets going.
+fn energy_of(samples: &[f64], from: usize, to: usize) -> f64 {
+    let to = to.min(samples.len() / CHANNELS);
+    if to <= from {
+        return 0.0;
+    }
+    let mut sum = 0.0;
+    for frame in from..to {
+        for channel in 0..CHANNELS {
+            let sample = samples[frame * CHANNELS + channel];
+            sum += sample * sample;
+        }
+    }
+    (sum / ((to - from) * CHANNELS) as f64).sqrt()
+}
+
+/// The bar where a quiet opening gives way to the song: the biggest rise
+/// into a bar that is loud, which is the drop an intro leads to. Without one
+/// the opening is already going, or nothing stands out.
+fn drop_bar(decoded: &[f64], available: usize, grid: &BeatGrid) -> Option<usize> {
+    let bar_frames = frames(grid.bar_ms());
+    if bar_frames < 512 || available < bar_frames * 2 {
+        return None;
+    }
+    let first = frames(grid.bar_at_or_after(0.0));
+    if first >= available {
+        return None;
+    }
+    let mut starts = Vec::new();
+    let mut start = first;
+    while starts.len() < 4 && start + bar_frames <= available {
+        starts.push(start);
+        start += bar_frames;
+    }
+    if starts.len() < 2 {
+        return None;
+    }
+    let levels: Vec<f64> = (0..starts.len())
+        .map(|index| {
+            let end = starts
+                .get(index + 1)
+                .copied()
+                .unwrap_or(start + bar_frames)
+                .min(available);
+            energy_of(decoded, starts[index], end)
+        })
+        .collect();
+    let loudest = levels.iter().copied().fold(0.0, f64::max);
+    if loudest <= f64::EPSILON {
+        return None;
+    }
+    let mut best: Option<(usize, f64)> = None;
+    for index in 1..levels.len() {
+        let rise = levels[index] - levels[index - 1];
+        if levels[index] >= loudest * 0.6 && best.is_none_or(|(_, top)| rise > top) {
+            best = Some((index, rise));
+        }
+    }
+    best.filter(|(_, rise)| *rise > loudest * 0.05)
+        .map(|(index, _)| starts[index])
+}
+
+/// Where the incoming track should enter the mix.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Entry {
+    /// Frames into the decoded opening where the mix begins.
+    pub at: usize,
+    /// The opening's beats and bar lines, when it has them.
+    pub grid: Option<BeatGrid>,
+}
+
+/// Finds the incoming track's entry: its first strong attack in the opening,
+/// so the mix starts on a beat rather than in the middle of a phrase, and the
+/// tempo that attack belongs to.
+pub fn opening_entry(decoded: &[f64], available: usize) -> Entry {
+    let available = available.min(decoded.len() / CHANNELS);
+    if available == 0 {
+        return Entry::default();
+    }
+    let mut tracker = BeatTracker::new(0);
+    tracker.feed(&decoded[..available * CHANNELS], 0);
+    let grid = tracker
+        .estimate()
+        .filter(|grid| grid.confidence >= MIN_CONFIDENCE);
+
+    let limit = ms_of(available.min(frames(2500.0)));
+    let peak = tracker.onsets.iter().copied().fold(0.0f32, f32::max);
+    let mut entry_ms = None;
+    if peak > f32::EPSILON {
+        for (time, strength) in tracker.heard() {
+            if time < 120.0 {
+                continue;
+            }
+            if time > limit as f64 {
+                break;
+            }
+            if strength >= peak * 0.45 {
+                // Keep the few milliseconds that carry the attack.
+                entry_ms = Some((time - 12.0).max(0.0));
+                break;
+            }
+        }
+    }
+
+    // Enter where a quiet intro gives way to the song, else on the bar line
+    // nearest the attack, so the incoming phrase starts where the outgoing
+    // one ends.
+    let at_ms = match grid {
+        Some(grid) => {
+            let attack = entry_ms.map(|attack| {
+                let before = grid.bar_at_or_before(attack);
+                // The bar the attack is on, unless it is only just past the
+                // line; otherwise the next one, so the opening does not begin
+                // in the silence before the attack.
+                if attack - before <= 250.0 {
+                    before
+                } else {
+                    before + grid.bar_ms()
+                }
+            });
+            // A drop later than this is too much of the song to skip; the
+            // opening plays through instead.
+            let drop = drop_bar(decoded, available, &grid)
+                .map(|drop| ms_of(drop) as f64)
+                .filter(|drop| *drop <= 4_000.0);
+            drop.or(attack).unwrap_or(0.0).clamp(0.0, 4_000.0)
+        }
+        None => entry_ms.unwrap_or(0.0),
+    };
+    Entry {
+        at: frames(at_ms).min(available.saturating_sub(1)),
+        grid,
+    }
+}
+
+/// `samples` from `from`, played `out_frames` long, with `ratio` content
+/// frames per output frame. A ratio of one copies the opening; anything else
+/// pulls it to another tempo, which also moves its pitch.
+pub fn stretch(samples: &[f64], from: usize, out_frames: usize, ratio: f64) -> Vec<f64> {
+    let mut out = Vec::with_capacity(out_frames * CHANNELS);
+    let start = from * CHANNELS;
+    for frame in 0..out_frames {
+        let position = frame as f64 * ratio;
+        let index = position.floor() as usize;
+        let fraction = position - index as f64;
+        for channel in 0..CHANNELS {
+            let base = start + index * CHANNELS + channel;
+            let first = samples.get(base).copied().unwrap_or(0.0);
+            let second = samples.get(base + CHANNELS).copied().unwrap_or(first);
+            out.push(first + (second - first) * fraction);
+        }
+    }
+    out
+}
+
+/// Cuts the incoming track's low end as the mix begins and brings it back as
+/// the outgoing one leaves: the bass swap a DJ makes so two kicks and two
+/// basslines do not pile up. Only the opening is touched; by its end the low
+/// end is whole again.
+pub fn bass_swap(samples: &mut [f64], frames: usize) {
+    let frames = frames.min(samples.len() / CHANNELS);
+    if frames < 2 {
+        return;
+    }
+    // A first-order high pass whose corner slides down from the kick's band
+    // to open: steep enough to take the low end out, with no crossover
+    // subtraction to leave a residue behind.
+    let mut previous_in = [0.0f64; CHANNELS];
+    let mut previous_out = [0.0f64; CHANNELS];
+    let mut coefficient = 0.0;
+    for frame in 0..frames {
+        if frame % 256 == 0 {
+            let through = frame as f64 / frames as f64;
+            let corner = if through < 0.35 {
+                500.0
+            } else if through < 0.85 {
+                // Slide from 500 Hz to 5 Hz across the middle of the mix.
+                500.0 * (5.0f64 / 500.0).powf((through - 0.35) / 0.5)
+            } else {
+                5.0
+            };
+            coefficient = (-std::f64::consts::TAU * corner / SAMPLE_RATE as f64).exp();
+        }
+        for channel in 0..CHANNELS {
+            let sample = samples[frame * CHANNELS + channel];
+            let filtered = coefficient * (previous_out[channel] + sample - previous_in[channel]);
+            previous_in[channel] = sample;
+            previous_out[channel] = filtered;
+            samples[frame * CHANNELS + channel] = filtered;
+        }
+    }
+}
+
+/// Pulls the low end out of the outgoing song as it leaves: the filter a DJ
+/// sweeps across the last bars, so the two songs do not share the bottom of
+/// the spectrum at full level while they overlap.
+#[derive(Clone, Copy, Debug)]
+pub struct Sweep {
+    previous_in: [f64; CHANNELS],
+    previous_out: [f64; CHANNELS],
+    coefficient: f64,
+}
+
+impl Default for Sweep {
+    fn default() -> Self {
+        Self {
+            previous_in: [0.0; CHANNELS],
+            previous_out: [0.0; CHANNELS],
+            coefficient: (-std::f64::consts::TAU * 20.0 / SAMPLE_RATE as f64).exp(),
+        }
+    }
+}
+
+impl Sweep {
+    /// Filters `data`, the outgoing song's frames from `played` of `total`.
+    /// The corner stays out of the way until the mix is a third through, then
+    /// climbs to 1.5 kHz, leaving the sound thin as the song goes.
+    pub fn process(&mut self, data: &mut [f64], played: usize, total: usize) {
+        if total == 0 {
+            return;
+        }
+        for (index, frame) in data.chunks_exact_mut(CHANNELS).enumerate() {
+            if (played + index) % 256 == 0 || index == 0 {
+                let through = (played + index) as f64 / total as f64;
+                let corner = if through < 0.35 {
+                    20.0
+                } else if through < 0.9 {
+                    20.0 * (1_500.0f64 / 20.0).powf((through - 0.35) / 0.55)
+                } else {
+                    1_500.0
+                };
+                self.coefficient = (-std::f64::consts::TAU * corner / SAMPLE_RATE as f64).exp();
+            }
+            for (channel, sample) in frame.iter_mut().enumerate() {
+                let input = *sample;
+                let filtered = self.coefficient
+                    * (self.previous_out[channel] + input - self.previous_in[channel]);
+                self.previous_in[channel] = input;
+                self.previous_out[channel] = filtered;
+                *sample = filtered;
+            }
+        }
+    }
+}
+
+/// The equal-power gains at `t` through a fade: `(incoming, outgoing)`.
+/// Their squares sum to one, so the mix neither dips nor swells.
+pub fn gains(t: f64) -> (f64, f64) {
+    let angle = t.clamp(0.0, 1.0) * std::f64::consts::FRAC_PI_2;
+    angle.sin_cos()
+}
+
+/// Mixes `opening` over `outgoing` from `played` frames in, and returns the
+/// frames mixed. `gain` carries the incoming track's own normalisation.
+pub fn mix(
+    outgoing: &mut [f64],
+    opening: &[f64],
+    played: usize,
+    frames: usize,
+    gain: f64,
+) -> usize {
+    if frames == 0 {
+        return 0;
+    }
+    let available = (outgoing.len() / CHANNELS).min(frames.saturating_sub(played));
+    for frame in 0..available {
+        let at = played + frame;
+        let (incoming, out) = gains(at as f64 / frames as f64);
+        for channel in 0..CHANNELS {
+            let sample = &mut outgoing[frame * CHANNELS + channel];
+            let head = opening.get(at * CHANNELS + channel).copied().unwrap_or(0.0);
+            *sample = *sample * out + head * incoming * gain;
+        }
+    }
+    available
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
