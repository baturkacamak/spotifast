+    #[test]
+    fn the_tracker_finds_the_beats_of_a_steady_track() {
+        for bpm in [98.0, 120.0, 128.0, 174.0] {
+            let samples = clicks(bpm, 8.0);
+            let mut tracker = BeatTracker::new(0);
+            tracker.feed(&samples, 0);
+            let grid = tracker
+                .estimate()
+                .unwrap_or_else(|| panic!("no beat at {bpm}"));
+            // Within half a per cent: over eight beats that is under 50 ms.
+            let tolerance = 60_000.0 / bpm * 0.005;
+            assert!(
+                (grid.period_ms - 60_000.0 / bpm).abs() < tolerance,
+                "{bpm}: {} ms a beat",
+                grid.period_ms
+            );
+            assert!(
+                grid.confidence >= MIN_CONFIDENCE,
+                "{bpm}: {}",
+                grid.confidence
+            );
+            // A click sits on the first beat, give or take a hop.
+            let first = grid.phase_ms;
+            let near_click = first.min(grid.period_ms - first);
+            assert!(near_click < 30.0, "{bpm}: first beat at {first}");
+        }
+    }
