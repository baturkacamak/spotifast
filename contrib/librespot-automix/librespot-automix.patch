+    /// Clicks of `bpm` over `seconds`, at the playback rate.
+    fn clicks(bpm: f64, seconds: f64) -> Vec<f64> {
+        let rate = SAMPLE_RATE as f64;
+        let mut samples = vec![0.0; (seconds * rate) as usize * CHANNELS];
+        let period = rate * 60.0 / bpm;
+        let mut click = 0.0;
+        while click < seconds * rate {
+            let start = click as usize;
+            for offset in 0..(rate * 0.05) as usize {
+                let at = start + offset;
+                if at >= samples.len() / CHANNELS {
+                    break;
+                }
+                let envelope = (-(offset as f64) / (rate * 0.012)).exp();
+                let value =
+                    (offset as f64 / rate * 80.0 * std::f64::consts::TAU).sin() * envelope * 0.8;
+                samples[at * CHANNELS] = value;
+                samples[at * CHANNELS + 1] = value;
+            }
+            click += period;
+        }
+        samples
+    }
+
+    #[test]
+    fn the_fade_keeps_the_power_of_the_two_songs_at_one() {
+        for step in 0..=100 {
+            let (incoming, outgoing) = gains(step as f64 / 100.0);
+            let power = incoming * incoming + outgoing * outgoing;
+            assert!((power - 1.0).abs() < 1e-9, "{power} at {step}");
+        }
+        assert_eq!(gains(0.0), (0.0, 1.0));
+        let (incoming, outgoing) = gains(1.0);
+        assert!(incoming > 0.999 && outgoing.abs() < 1e-9);
+    }
+
+    #[test]
+    fn the_mix_fades_the_song_out_while_the_next_one_comes_in() {
+        let mut outgoing = vec![1.0f64; 100 * CHANNELS];
+        let opening = vec![1.0f64; 100 * CHANNELS];
+        let mixed = mix(&mut outgoing, &opening, 0, 100, 1.0);
+        assert_eq!(mixed, 100);
+        assert!(
+            (outgoing[0] - 1.0).abs() < 1e-9,
+            "the first frame is the old song"
+        );
+        let last = 99 * CHANNELS;
+        assert!(
+            (outgoing[last] - 1.0).abs() < 0.02,
+            "the last is nearly the new one"
+        );
+        // Halfway the two are equal, at equal power.
+        let middle = 50 * CHANNELS;
+        assert!((outgoing[middle] - std::f64::consts::SQRT_2).abs() < 1e-3);
+        // No frame is louder than either song alone by more than the sum.
+        assert!(
+            outgoing
+                .iter()
+                .all(|sample| *sample <= std::f64::consts::SQRT_2 + 1e-9)
+        );
+        assert!(outgoing.chunks(CHANNELS).all(|frame| frame[0] == frame[1]));
+    }
+
