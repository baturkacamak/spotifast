+    #[test]
+    fn a_half_time_beat_is_counted_as_its_faster_beats() {
+        // A kick every two beats, with a quieter hat in between.
+        let mut samples = clicks(120.0, 8.0);
+        let rate = SAMPLE_RATE as f64;
+        let period = rate * 0.5;
+        let mut at = period / 2.0;
+        while at < 8.0 * rate {
+            for offset in 0..(rate * 0.02) as usize {
+                let index = (at as usize + offset) * CHANNELS;
+                if index >= samples.len() {
+                    break;
+                }
+                let value = (offset as f64 / rate * 180.0 * std::f64::consts::TAU).sin() * 0.2;
+                samples[index] += value;
+                samples[index + 1] += value;
+            }
+            at += period;
+        }
+        let mut tracker = BeatTracker::new(0);
+        tracker.feed(&samples, 0);
+        let grid = tracker.estimate().expect("a beat");
+        assert!(
+            (grid.period_ms - 500.0).abs() < 30.0,
+            "{} ms a beat, not 1000",
